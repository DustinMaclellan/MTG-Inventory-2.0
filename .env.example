# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mystic_ledger?schema=public"

# ─── App URL ──────────────────────────────────────────────────────────────────
# REQUIRED in production. Set to your public domain (no trailing slash).
# Used for Stripe success/cancel URLs and password-reset email links.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback if APP_URL is
# not set. VERCEL_URL (per-deployment) is intentionally NOT used as a fallback
# because it changes on every deploy and would break Stripe redirect URLs.
APP_URL="http://localhost:3000"

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE="false"

# ─── Cron ────────────────────────────────────────────────────────────────────
# REQUIRED in production. A random secret sent by Vercel Cron in the
# Authorization: Bearer header to authenticate scheduled sync requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Optional. How many Scryfall search pages the daily catalog job fetches.
# Default is 10. Lower this on Vercel Hobby if /api/cron/catalog-sync times out.
# SCRYFALL_SYNC_PAGES="10"

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Start with test-mode keys. Leave empty to run the app without checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# In development, password-reset links are printed to the console when unset.
RESEND_API_KEY=""
EMAIL_FROM="Mystic Ledger <onboarding@resend.dev>"
